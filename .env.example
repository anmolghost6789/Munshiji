# ── Required in production ─────────────────────────────────────────
NEXTAUTH_URL=https://munshiji.telix.example        # the public https address
NEXTAUTH_SECRET=                                   # 32+ random characters: openssl rand -base64 48
DATABASE_URL=postgresql://munshiji_app:pass@host:5432/munshiji?sslmode=require   # the APP role: not superuser, no BYPASSRLS
# Migrations, backups and restores use the database OWNER role instead (it can read every business):
# MIGRATE_DATABASE_URL=postgresql://owner:pass@host:5432/munshiji?sslmode=require
# MUNSHIJI_APP_ROLE=munshiji_app                   # restore re-grants this role's access
# PG_POOL_MAX=10                                   # connections per instance (defaults to 3 on Vercel, 10 elsewhere)

# ── Backups ────────────────────────────────────────────────────────
MUNSHIJI_BACKUP_DIR=/var/backups/munshiji          # for npm run backup (pg_dump); managed backups on RDS/Neon come first
MUNSHIJI_BACKUP_KEEP=30

# ── Email (Resend): password reset, email confirmation, invites ──
RESEND_API_KEY=                                    # from resend.com → API Keys
MUNSHIJI_EMAIL_FROM="Munshiji <hello@yourdomain.in>"   # a domain verified in Resend (RESEND_FROM or EMAIL_FROM also work)
# Without a sender, Resend's test sender is used: it only delivers to your Resend account's own email.

# ── Optional: AI message reading (otherwise the basic reader is used) ─
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Optional: WhatsApp forwarding (Meta WhatsApp Cloud API) ────────
WHATSAPP_APP_SECRET=                               # Meta app secret (verifies every webhook call)
WHATSAPP_VERIFY_TOKEN=                             # any random string; also entered in Meta's webhook settings
WHATSAPP_PHONE_NUMBER_ID=                          # the Munshiji number's ID (receives forwards, sends replies)
WHATSAPP_ACCESS_TOKEN=                             # permanent token of a Meta system user, for replies
MUNSHIJI_WHATSAPP_NUMBER="+91 90000 00000"          # shown to users: where to forward orders and send LINK codes
# WHATSAPP_GRAPH_VERSION=v23.0


# ── Company details for Terms, Privacy and Help pages (placeholders show until set) ──
MUNSHIJI_LEGAL_NAME=                               # registered company name
MUNSHIJI_LEGAL_ADDRESS=
MUNSHIJI_SUPPORT_EMAIL=
MUNSHIJI_SUPPORT_WHATSAPP=                         # a support number, not the order number
MUNSHIJI_SUPPORT_HOURS="Mon–Sat 10:00–19:00 IST"
MUNSHIJI_GRIEVANCE_OFFICER=
MUNSHIJI_GRIEVANCE_EMAIL=
MUNSHIJI_JURISDICTION_CITY=
MUNSHIJI_DATA_LOCATION="AWS Mumbai (ap-south-1)"
# MUNSHIJI_LEGAL_REVIEWED=1                        # set only after a lawyer has approved the Terms and Privacy Policy
